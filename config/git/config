[credential]
	helper = store
[init]
    defaultBranch = main
[alias]
    ac="!f() { git add . && git commit -m \"$1\"; }; f"
[rerere]
	enabled = true
[submodule]
    recurse = true
[push]
    recurseSubmodules = no
[include]
    path=local_config
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
