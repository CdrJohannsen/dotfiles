# vim: foldmethod=marker

include /etc/sway/config.d/*

# Direction keys (as variables in case I want to switch to hjkl)
set $left Left
set $down Down
set $up Up
set $right Right

# {{{ Input config
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    pointer_accel 0.4
    dwt disabled
    accel_profile flat
    drag_lock disabled
}

#
input "type:keyboard" {
    xkb_layout "de(nodeadkeys)"
    # do not use spaces after comma
    xkb_options lv3:caps_switch,lv5:rctrl_switch,compose:ralt,nbsp:zwnj2zwj3nb4,keypad:oss,kpdl:commaoss
    xkb_numlock enabled
}
# mouse config
input "type:pointer" {
    accel_profile flat
    pointer_accel 0.1
}

seat * {
    hide_cursor 20000
}

# }}}

# {{{ Output config
output * {
    background ~/.config/wallpapers/ball_blocks_orange.png fill
}

output eDP-1 {
	mode 1920x1080@60Hz
    subpixel rgb
}

output HDMI-A-1 {
    mode 1920x1080@144Hz
    position 0 0
    subpixel rgb
}

output DP-1 {
	mode 1920x1080@60Hz
    position -1080 -420
    transform 270
}
# }}}

# {{{ Visual config
gaps inner 10
gaps outer 0
smart_gaps on

default_border pixel 2
default_floating_border pixel 2
smart_borders no_gaps
# This is here because floating windows don't get a border for some reason
for_window [app_id=".*"] border pixel 2

corner_radius 10
smart_corner_radius enable

blur enable
blur_radius 5
blur_passes 1

shadows enable
shadow_blur_radius 20
shadow_color #ffff00ff
shadow_inactive_color #dd9900ff

animation_duration_ms 300


set $indicator #dcaa22
set $active_border #ffeedd
set $inactive_border #ffddaa

set $background #100a00
set $foreground $inactive_border

client.focused $active_border $background $foreground $indicator $active_border
client.unfocused $background $background $foreground $indicator $inactive_border
client.focused_inactive  $inactive_border $background $foreground $indicator $inactive_border
# }}}

mouse_warping  output
focus_follows_mouse no
primary_selection disabled


bindsym Super+Shift+c reload
bindsym Super+Shift+y exec swaymsg exit

# {{{ Exec keybinds
bindsym Super+t exec alacritty
bindsym Super+w exec firefox
bindsym Super+period exec gnome-characters || kcharselect
bindsym Super+shift+t exec gnome-calculator || kcalc
bindsym Super+Ctrl+c exec grimpicker -c
bindsym Super+p exec cliphist list | wofi -S dmenu | cliphist decode | wl-copy
# shutdown
bindsym Ctrl+Alt+Delete exec shutdown now
bindsym Ctrl+Alt+Backspace exec nwgbar -o 0 -s 48
bindsym Super+n exec swaync-client -t
bindsym XF86NotificationCenter exec swaync-client -t
bindsym Super+l exec loginctl lock-session

bindswitch tablet:on exec flock -n /tmp/osk.lock wvkbd-deskintl --auto --no-popup & killall -35 waybar
bindswitch tablet:off exec killall wvkbd-deskintl && killall -35 waybar

bindswitch lid:on exec systemctl suspend


# Kill focused widow
bindsym Super+q kill

# Start your launcher
set $menu killall wofi || wofi
bindsym --release Super_L exec $menu
bindsym --release Super_R exec $menu

bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume +1
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume -1
bindsym Super+F4 exec swayosd-client --input-volume mute-toggle
bindsym XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym XF86AudioNext exec swayosd-client --playerctl next
bindsym XF86AudioPrev exec swayosd-client --playerctl previous
bindsym Ctrl+XF86AudioNext exec playerctl position 5+
bindsym Ctrl+XF86AudioPrev exec playerctl position 5-
bindsym Ctrl+Shift+XF86AudioNext exec playerctl position 20+
bindsym Ctrl+Shift+XF86AudioPrev exec playerctl position 20-
bindsym XF86AudioPlay exec swayosd-client --playerctl play-pause
bindsym XF86AudioStop exec swayosd-client --playerctl stop
bindsym Num_Lock exec sleep 0.1 && swayosd-client --num-lock
bindsym XF86MonBrightnessUp exec swayosd-client --brightness +10
bindsym XF86MonBrightnessDown exec swayosd-client --brightness -10

set $screenshot_area grim -g "$(slurp)" - | wl-copy
bindsym Super+Shift+s exec $screenshot_area
bindsym XF86SelectiveScreenshot exec $screenshot_area
bindsym print exec grim - | wl-copy

bindsym Super+d exec ~/Projects/Python/Translator/main.py
# }}}

# {{{ Nav keybinds
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next

bindgesture swipe:4:up move up 200
bindgesture swipe:4:down move down 200
bindgesture swipe:4:left move left 200
bindgesture swipe:4:right move right 200

bindgesture pinch:3:inward floating enable
bindgesture pinch:3:outward floating disable


floating_modifier Super normal

# Moving around:
# Move your focus around
bindsym Super+$left focus left
bindsym Super+$down focus down
bindsym Super+$up focus up
bindsym Super+$right focus right
# Move focus with Tab
bindsym Super+tab focus next
bindsym Super+shift+tab focus prev
# move windows
bindsym Super+shift+$left move left
bindsym Super+shift+$down move down
bindsym Super+shift+$up move up
bindsym Super+shift+$right move right

# Workspaces:
# Switch to workspace
bindsym Super+1 workspace 1
bindsym Super+2 workspace 2
bindsym Super+3 workspace 3
bindsym Super+4 workspace 4
bindsym Super+5 workspace 5
bindsym Super+6 workspace 6
bindsym Super+7 workspace 7
bindsym Super+8 workspace 8
bindsym Super+9 workspace 9

# Move focused container to workspace
bindsym Super+Shift+1 move container to workspace 1, workspace 1
bindsym Super+Shift+2 move container to workspace 2, workspace 2
bindsym Super+Shift+3 move container to workspace 3, workspace 3
bindsym Super+Shift+4 move container to workspace 4, workspace 4
bindsym Super+Shift+5 move container to workspace 5, workspace 4
bindsym Super+Shift+6 move container to workspace 6, workspace 6
bindsym Super+Shift+7 move container to workspace 7, workspace 7
bindsym Super+Shift+8 move container to workspace 8, workspace 8
bindsym Super+Shift+9 move container to workspace 9, workspace 9

# move to another workspace
bindsym Super+ctrl+Right move workspace to output right
bindsym Super+Ctrl+Left move workspace to output left

bindsym Super+Shift+0 move scratchpad
bindsym Super+0 scratchpad show
# }}}

# {{{ Layout keybinds
bindsym Super+f fullscreen
bindsym Super+Shift+f fullscreen global

bindsym Super+e layout toggle split tabbed

# toggle layout
bindsym Super+a focus parent, layout toggle splitv splith, focus child

bindsym Super+space floating toggle

# Resizing containers:
mode "resize" {
    bindsym $right resize grow width 24px
    bindsym $down resize shrink height 24px
    bindsym $up resize grow height 24px
    bindsym $left resize shrink width 24px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym Super+v mode "resize"
# }}}

# Status Bar:
bar {
    swaybar_command waybar
}

# {{{ Position configuration
# Workspace
workspace 9 output eDP-1
workspace 8 output eDP-1
workspace 9 output DP-1
workspace 8 output DP-1
assign [app_id="discord"] workspace 9
assign [app_id="org.signal.Signal"] workspace 9
assign [app_id="net.thunderbird.Thunderbird"] workspace 9
assign [app_id="spotify"] workspace 8
assign [app_id="com.github.wwmm.easyeffects"] workspace 8

for_window [workspace="9"] layout tabbed
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="org.kde.kcalc"] floating enable
for_window [app_id="io.github.finefindus.Hieroglyphic"] floating enable
for_window [app_id="discord"] inhibit_idle focus
for_window [app_id="Ryujinx"] inhibit_idle focus
for_window [app_id=".*"] inhibit_idle fullscreen

for_window [title="Picture-in-Picture"] floating enable, move absolute position -1080 0, resize set width 1080 px height 608 px
# }}}

# Autostart
exec GTK_THEME=Adwaita:dark

exec swayidle -w
exec swaync
exec wlsunset -l 50 -L 10
exec wl-paste --watch cliphist store
exec swayosd-server
exec /usr/libexec/kf6/polkit-kde-authentication-agent-1 | /usr/libexec/polkit-gnome-authentication-agent-1
exec autotiling

include "$(hostname)"
include private-config

focus floating
